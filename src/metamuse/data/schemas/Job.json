{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project Id"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "request_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    },
    "payload_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Digest",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "state": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "partial",
        "failed",
        "awaiting_user",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "coverage_status": {
      "default": "unknown",
      "enum": [
        "unknown",
        "scope_satisfied",
        "bounded",
        "partial"
      ],
      "title": "Coverage Status",
      "type": "string"
    },
    "requested_scope": {
      "additionalProperties": true,
      "title": "Requested Scope",
      "type": "object"
    },
    "observed_scope": {
      "additionalProperties": true,
      "title": "Observed Scope",
      "type": "object"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "limits": {
      "additionalProperties": true,
      "title": "Limits",
      "type": "object"
    },
    "worker_epoch": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Epoch"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "remote_state": {
      "default": "unknown",
      "title": "Remote State",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    }
  },
  "required": [
    "id",
    "project_id",
    "operation",
    "request_key",
    "payload_digest",
    "payload",
    "created_at",
    "updated_at"
  ],
  "title": "Job",
  "type": "object"
}

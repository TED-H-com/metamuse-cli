{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "muse_observation"
          }
        }
      },
      "then": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      }
    }
  ],
  "properties": {
    "kind": {
      "enum": [
        "item_revision",
        "transcript_segment",
        "draft_revision",
        "muse_observation"
      ],
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "id",
    "revision"
  ],
  "title": "EvidenceRef",
  "type": "object"
}

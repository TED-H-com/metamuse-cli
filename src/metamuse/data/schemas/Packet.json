{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "item_revision",
            "transcript_segment",
            "draft_revision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Project Id",
      "type": "string"
    },
    "selection": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Selection",
      "type": "array"
    },
    "rendered_text": {
      "maxLength": 1000000,
      "title": "Rendered Text",
      "type": "string",
      "x-max-utf8-bytes": 49152
    },
    "redactions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Redactions",
      "type": "array"
    },
    "coverage_status": {
      "default": "unknown",
      "enum": [
        "unknown",
        "scope_satisfied",
        "bounded",
        "partial"
      ],
      "title": "Coverage Status",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "project_id",
    "selection",
    "rendered_text",
    "digest",
    "created_at"
  ],
  "title": "Packet",
  "type": "object"
}

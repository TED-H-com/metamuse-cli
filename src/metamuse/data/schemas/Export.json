{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "muse_observation"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "const": 1
              }
            }
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "item_revision",
            "transcript_segment",
            "draft_revision",
            "muse_observation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Project Id",
      "type": "string"
    },
    "selection": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Selection",
      "type": "array"
    },
    "format": {
      "title": "Format",
      "type": "string"
    },
    "manifest": {
      "additionalProperties": true,
      "title": "Manifest",
      "type": "object"
    },
    "artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact"
    },
    "state": {
      "default": "staging",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "selection",
    "format"
  ],
  "title": "Export",
  "type": "object"
}

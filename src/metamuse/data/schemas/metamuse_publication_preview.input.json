{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Project Id",
      "type": "string"
    },
    "draft_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Draft Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "account": {
      "title": "Account",
      "type": "string"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    }
  },
  "required": [
    "project_id",
    "draft_id",
    "revision",
    "account",
    "destination"
  ],
  "title": "PublicationPreviewRequest",
  "type": "object"
}

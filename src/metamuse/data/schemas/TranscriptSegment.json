{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Asset Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "end_ms": {
      "minimum": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "text": {
      "maxLength": 1000000,
      "title": "Text",
      "type": "string"
    },
    "language": {
      "default": "und",
      "title": "Language",
      "type": "string"
    },
    "method": {
      "enum": [
        "provided",
        "auto",
        "asr",
        "manual"
      ],
      "title": "Method",
      "type": "string"
    },
    "review": {
      "default": "unreviewed",
      "title": "Review",
      "type": "string"
    }
  },
  "required": [
    "id",
    "asset_id",
    "revision",
    "start_ms",
    "end_ms",
    "text",
    "method"
  ],
  "title": "TranscriptSegment",
  "type": "object"
}

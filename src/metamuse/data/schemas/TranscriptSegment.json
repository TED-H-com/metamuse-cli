{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Project Id",
      "type": "string"
    },
    "asset_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "item_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "source_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "cue_index": {
      "default": 0,
      "minimum": 0,
      "title": "Cue Index",
      "type": "integer"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "end_ms": {
      "minimum": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "text": {
      "maxLength": 1000000,
      "title": "Text",
      "type": "string"
    },
    "language": {
      "default": "und",
      "title": "Language",
      "type": "string"
    },
    "method": {
      "enum": [
        "provided",
        "auto",
        "asr",
        "manual"
      ],
      "title": "Method",
      "type": "string"
    },
    "review": {
      "default": "unreviewed",
      "title": "Review",
      "type": "string"
    },
    "overlap": {
      "default": false,
      "title": "Overlap",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "project_id",
    "revision",
    "start_ms",
    "end_ms",
    "text",
    "method"
  ],
  "title": "TranscriptSegment",
  "type": "object"
}

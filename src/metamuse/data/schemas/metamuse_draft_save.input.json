{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DraftPreferences": {
      "additionalProperties": false,
      "description": "Short explicit values for this draft; no permanent policy is learned.",
      "properties": {
        "language": {
          "default": "und",
          "maxLength": 35,
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "emoji": {
          "default": "unspecified",
          "maxLength": 32,
          "minLength": 1,
          "title": "Emoji",
          "type": "string"
        },
        "format": {
          "default": "plain_text",
          "enum": [
            "plain_text",
            "markdown"
          ],
          "title": "Format",
          "type": "string"
        },
        "scope": {
          "const": "this_draft",
          "default": "this_draft",
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "DraftPreferences",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "item_revision",
            "transcript_segment",
            "draft_revision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Project Id",
      "type": "string"
    },
    "draft_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Draft Id"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "text": {
      "maxLength": 1000000,
      "title": "Text",
      "type": "string"
    },
    "platform": {
      "enum": [
        "facebook",
        "instagram",
        "threads",
        "youtube",
        "tiktok",
        "x",
        "generic"
      ],
      "title": "Platform",
      "type": "string"
    },
    "facts_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Facts Refs",
      "type": "array"
    },
    "assets": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "type": "string"
      },
      "title": "Assets",
      "type": "array"
    },
    "variant": {
      "additionalProperties": true,
      "title": "Variant",
      "type": "object"
    },
    "preferences": {
      "$ref": "#/$defs/DraftPreferences"
    },
    "request_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "text",
    "platform",
    "request_key"
  ],
  "title": "DraftSaveRequest",
  "type": "object"
}

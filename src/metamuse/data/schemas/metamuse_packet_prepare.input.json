{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "muse_observation"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "const": 1
              }
            }
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "item_revision",
            "transcript_segment",
            "draft_revision",
            "muse_observation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Project Id",
      "type": "string"
    },
    "selection": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Selection",
      "type": "array"
    },
    "request_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "selection",
    "request_key"
  ],
  "title": "PacketPrepareRequest",
  "type": "object"
}

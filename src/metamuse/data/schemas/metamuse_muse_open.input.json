{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "discussion_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discussion Id"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Project Id",
      "type": "string"
    },
    "topic": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Topic",
      "type": "string",
      "x-max-utf8-bytes": 8192
    },
    "access_grant_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Grant Id"
    },
    "request_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "topic",
    "request_key"
  ],
  "title": "MuseOpenRequest",
  "type": "object"
}

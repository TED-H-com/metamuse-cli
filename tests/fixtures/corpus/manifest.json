    "import/comments_tree.jsonl": {
      "format": "jsonl",
      "purpose": "Reply tree relationship test cases (nested replies, unresolved orphan, self-loop, 2-node/3-node cycles, duplicate native IDs with identical and different text, weak identities, identical text comments)",
      "at_ids": [
        "AT-004",
        "AT-013"
      ],
      "sha256": "12b8b16a232a806e51c96b37e68d76ec8525403a0b59287142bf9843f5f157dc",
      "size_bytes": 8250,
      "expected": {
        "total_rows": 19,
        "valid_rows": 19,
        "parent_resolutions": {
          "post-tree-root": {
            "expected_parent": null,
            "status": "resolved",
            "notes": "Root post"
          },
          "c-tree-valid-1": {
            "expected_parent": "post-tree-root",
            "status": "resolved",
            "notes": "1st level valid child"
          },
          "r-tree-valid-1-1": {
            "expected_parent": "c-tree-valid-1",
            "status": "resolved",
            "notes": "2nd level valid reply"
          },
          "r-tree-valid-1-1-1": {
            "expected_parent": "r-tree-valid-1-1",
            "status": "resolved",
            "notes": "3rd level nested reply"
          },
          "c-tree-orphan": {
            "expected_parent": null,
            "status": "unresolved",
            "notes": "Parent c-nonexistent-parent-999 is absent"
          },
          "c-tree-self-loop": {
            "expected_parent": null,
            "status": "rejected_self_parent",
            "error_code": "E_REFERENCE_INVALID",
            "notes": "SPEC §3: a self-parent is a bad reference. The incoming row is rejected and not inserted."
          },
          "c-cycle2-node-a": {
            "expected_parent": null,
            "status": "unresolved",
            "notes": "SPEC §3: the parent is not obtained yet, so the row stays unresolved. It is not rejected as a cycle."
          },
          "c-cycle2-node-b": {
            "expected_parent": null,
            "status": "rejected_cycle",
            "error_code": "E_REFERENCE_INVALID",
            "notes": "Linking this row to node A would cycle. Only the incoming row is rejected."
          },
          "c-cycle3-node-a": {
            "expected_parent": "c-cycle3-node-b",
            "status": "resolved",
            "notes": "Node B is kept. Linking A to B does not yet cycle."
          },
          "c-cycle3-node-b": {
            "expected_parent": null,
            "status": "unresolved",
            "notes": "Node C is the row that would close the cycle, so B's parent stays unresolved."
          },
          "c-cycle3-node-c": {
            "expected_parent": null,
            "status": "rejected_cycle",
            "error_code": "E_REFERENCE_INVALID",
            "notes": "SPEC §3: reject the incoming row that would cycle. Earlier rows stay."
          },
          "c-dup-identical": {
            "expected_parent": "post-tree-root",
            "status": "resolved",
            "notes": "Duplicate native ID with identical text (idempotent dedup)"
          },
          "c-dup-revision": {
            "expected_parent": "post-tree-root",
            "status": "resolved",
            "notes": "Duplicate native ID with different text (revision append per AT-013)"
          },
          "weak_identity_anonymous": {
            "status": "weak_identity_created",
            "notes": "native_id is null; internal weak identity created per SPEC §3"
          },
          "c-same-text-01": {
            "expected_parent": "post-tree-root",
            "status": "resolved",
            "notes": "Distinct identity despite identical text as c-same-text-02"
          },
          "c-same-text-02": {
            "expected_parent": "post-tree-root",
            "status": "resolved",
            "notes": "Distinct identity despite identical text as c-same-text-01"
          }
        }
      }
    },
